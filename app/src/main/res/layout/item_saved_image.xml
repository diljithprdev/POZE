<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/ripple_row"
    android:orientation="vertical"
    android:padding="@dimen/space_xs">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivThumb"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/bg_gallery_tile"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:scaleType="centerCrop" />

        <FrameLayout
            android:id="@+id/badgeDelete"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_gravity="top|end"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:contentDescription="@string/delete"
            android:focusable="true"
            android:foreground="@drawable/ripple_circle"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_delete">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_minus"
                    android:tint="@color/poze_on_primary" />
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/poze_on_surface"
        android:textSize="@dimen/text_caption" />

    <TextView
        android:id="@+id/tvDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/poze_text_tertiary"
        android:textSize="@dimen/text_label" />
</LinearLayout>
