<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_base">

    <LinearLayout
        android:id="@+id/galContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xxl"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_xxl"
        android:paddingBottom="@dimen/space_lg">

        <LinearLayout
            android:id="@+id/galHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="-12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:padding="13dp"
                android:src="@drawable/ic_back"
                android:tint="@color/poze_home_text" />

            <TextView
                android:id="@+id/tvGalleryTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"
                android:maxLines="1"
                android:text="@string/choose_reference"
                android:textColor="@color/poze_home_text"
                android:textSize="@dimen/text_title" />

            <FrameLayout
                android:id="@+id/btnDelete"
                android:layout_width="@dimen/touch_circle"
                android:layout_height="@dimen/touch_circle"
                android:background="@drawable/bg_circle_ghost"
                android:clickable="true"
                android:contentDescription="@string/delete"
                android:focusable="true"
                android:foreground="@drawable/ripple_circle"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivDeleteIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_delete"
                    android:tint="@color/poze_on_surface_dim" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnAdd"
                android:layout_width="@dimen/touch_circle"
                android:layout_height="@dimen/touch_circle"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/bg_circle_accent"
                android:clickable="true"
                android:contentDescription="@string/select_from_gallery"
                android:focusable="true"
                android:foreground="@drawable/ripple_circle">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_add"
                    android:tint="@color/poze_on_accent" />
            </FrameLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/galScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_md"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/space_md"
            android:scrollbars="none">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <GridLayout
                    android:id="@+id/savedGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="48dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_empty_icon"
                        android:importantForAccessibility="no">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_image"
                            android:tint="@color/poze_accent_soft" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/no_saved_images"
                        android:textColor="@color/poze_home_text"
                        android:textSize="@dimen/text_headline" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.2"
                        android:text="@string/empty_gallery_hint"
                        android:textColor="@color/poze_home_sub"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </FrameLayout>
        </ScrollView>

        <TextView
            android:id="@+id/galHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_md"
            android:gravity="center"
            android:text="@string/one_off_hint"
            android:textColor="@color/poze_text_tertiary"
            android:textSize="@dimen/text_label" />

        <Button
            android:id="@+id/btnTransient"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_row"
            android:background="@drawable/bg_ghost_button"
            android:backgroundTint="@null"
            android:fontFamily="sans-serif-medium"
            android:foreground="@drawable/ripple_row"
            android:stateListAnimator="@null"
            android:text="@string/select_from_gallery"
            android:textAllCaps="false"
            android:textColor="@color/poze_accent_soft"
            android:textSize="@dimen/text_body" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
